# Demo backend environment example
# This backend must use a separate database from production.

DATABASE_URL="postgresql://user:password@localhost:5432/socialfi_demo?schema=public"

JWT_SECRET="replace-with-a-demo-secret"
JWT_REFRESH_SECRET="replace-with-a-demo-refresh-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=4000
NODE_ENV="production"
DEMO_MODE=true
DEMO_PATH_PREFIX="/demo"
FRONTEND_URL="https://socialmusicfi.com"
CORS_ORIGINS="https://socialmusicfi.com"

# Stripe is intentionally disabled or ignored in demo mode.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# On-chain actions are disabled in demo mode.
RPC_URL=""
TOKEN_CONTRACT_ADDRESS=""
OPERATOR_PRIVATE_KEY=""
CHAIN_ID=137
MIN_WITHDRAWAL=10
MAX_WITHDRAWAL=10000
SMFI_PER_ETH=1000

REFERRAL_RATE=0.05

S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_CDN_URL=""
MAX_FILE_SIZE=52428800

RESEND_API_KEY=""
FROM_EMAIL="noreply@socialmusicfi.com"
FROM_NAME="SocialFi Demo"