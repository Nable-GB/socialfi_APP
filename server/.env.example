# ============================================================================
# Database  (required)
# ============================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/socialfi_dapp?schema=public"

# ============================================================================
# Auth  (JWT_SECRET required; others have sensible defaults)
# ============================================================================
JWT_SECRET="your-jwt-secret-here"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-refresh-secret-here"
JWT_REFRESH_EXPIRES_IN="7d"

# ============================================================================
# Stripe (required — checkout + subscription + webhooks)
# ============================================================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ============================================================================
# Blockchain / Web3  (optional — needed for automatic on-chain payouts)
# ============================================================================
RPC_URL="https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY"
TOKEN_CONTRACT_ADDRESS="0x..."              # ERC-20 token for SMFI payouts
ESCROW_CONTRACT_ADDRESS="0x..."             # (legacy/future use)
OPERATOR_PRIVATE_KEY="0x..."                # Hot wallet that sends payouts
CHAIN_ID=137                                # 137=Polygon, 11155111=Sepolia
MIN_WITHDRAWAL=10                           # Minimum token withdrawal
MAX_WITHDRAWAL=10000                        # Maximum token withdrawal
SMFI_PER_ETH=1000                           # Exchange rate for SMFI→ETH swap

# ============================================================================
# S3 / Cloudflare R2 File Upload  (optional — needed for media uploads)
# ============================================================================
S3_BUCKET="socialfi-uploads"
S3_REGION="auto"                            # "auto" for Cloudflare R2
S3_ACCESS_KEY_ID="AKIA..."
S3_SECRET_ACCESS_KEY="..."
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"   # omit for AWS S3
S3_CDN_URL="https://cdn.example.com"        # public URL prefix (optional)
MAX_FILE_SIZE=52428800                       # 50 MB default

# ============================================================================
# App
# ============================================================================
PORT=4000
NODE_ENV="development"
DEMO_MODE=false                           # Set true only for a separate demo backend that fakes payment flows
FORCE_CREATOR_ACCESS=false                # Set true during testing to treat every signed-in user as CREATOR
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173"
REFERRAL_RATE=0.05                          # 5% affiliate cut

# ============================================================================
# Email — Resend  (optional — needed for verification / password reset)
# ============================================================================
RESEND_API_KEY="re_..."
FROM_EMAIL="noreply@socialmusicfi.com"
FROM_NAME="SocialFi"
