# Frontend Environment Variables
# Copy this file to .env.local and fill in your values.

# Backend API URL (points to Express server)
# Local development:
VITE_API_URL=http://localhost:4000
# Optional demo backend for /demo on the same frontend host:
# VITE_DEMO_API_URL=http://localhost:4001
# Production example:
# VITE_API_URL=https://socialfiapp-production.up.railway.app
# VITE_DEMO_API_URL=https://socialfi-demo-api.example.com
